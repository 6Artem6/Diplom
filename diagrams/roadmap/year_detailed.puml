@startuml
!theme plain
skinparam linetype ortho
skinparam rectangle {
  Shadowing false
  BorderColor black
  FontSize 8
  FontName Arial
}
skinparam package {
  BorderColor darkgreen
  FontColor darkgreen
  FontSize 10
  FontStyle bold
}

