@startuml
!theme plain
skinparam linetype ortho
left to right direction
skinparam rectangle {
  Shadowing false
  BorderColor black
  FontSize 9
  FontName Arial
}
skinparam package {
  BorderColor darkblue
  FontColor darkblue
  FontSize 12
  FontStyle bold
}

title Дорожная карта проекта SiteGPT (10 месяцев)\nСлои: Исследования, Разработка, Диссертация

' =======================
' СЛОЙ 1: ИССЛЕДОВАНИЯ
' =======================
package "ИСЛЕДОВАНИЯ" #F0E68C {
  rectangle "R1: Сбор литературы\n• AI агенты\n• Self-healing системы" as R1
  rectangle "R2: Анализ трендов 2025\n• Agentic AI\n• Micro-agents" as R2
  rectangle "R3: Определение исследовательских задач\n• Gap analysis" as R3
  rectangle "R4: Разработка прототипов агентов\n• Целеориентированные агенты" as R4
  rectangle "R5: Эксперименты с discovery стратегиями\n• Метрики эффективности" as R5
  rectangle "R6: Разработка self-healing алгоритмов\n• Simulation тесты" as R6
  rectangle "R7: Сбор данных и анализ\n• Метрики производительности" as R7
  rectangle "R8: Оптимизация моделей\n• Hyperparameter tuning" as R8
  rectangle "R9: Кросс-доменное обучение\n• Transfer learning" as R9
  rectangle "R10: Итоговый анализ\n• Документирование результатов" as R10
}

' Связи попарно
R1 --> R2
R2 --> R3
R3 --> R4
R4 --> R5
R5 --> R6
R6 --> R7
R7 --> R8
R8 --> R9
R9 --> R10

' =======================
' СЛОЙ 2: РАЗРАБОТКА
' =======================
package "РАЗРАБОТКА" #ADD8E6 {
  rectangle "D1: Проектирование архитектуры\n• Модули и интерфейсы" as D1
  rectangle "D2: Выбор технологий\n• ML/NLP/CV стеки" as D2
  rectangle "D3: Разработка базовых модулей\n• CoreSiteGPT" as D3
  rectangle "D4: Интеграция discovery агентов\n• Autonomy layer" as D4
  rectangle "D5: Интеграция self-healing\n• Monitoring & repair" as D5
  rectangle "D6: Интеграция multi-agent orchestration\n• Task coordination" as D6
  rectangle "D7: Разработка conversational workflow\n• NLP pipeline" as D7
  rectangle "D8: Тестирование модулей\n• Unit & integration tests" as D8
  rectangle "D9: Производственная оптимизация\n• Performance tuning" as D9
  rectangle "D10: Финальное развертывание\n• Deployment & monitoring" as D10
}

' Связи попарно
D1 --> D2
D2 --> D3
D3 --> D4
D4 --> D5
D5 --> D6
D6 --> D7
D7 --> D8
D8 --> D9
D9 --> D10

