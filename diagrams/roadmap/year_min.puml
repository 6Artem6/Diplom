  rectangle "T5: Прототипирование и эксперименты\n• Результаты R4-R7" as T5
  rectangle "T6: Анализ данных\n• Метрики и графики" as T6
  rectangle "T7: Обсуждение результатов\n• Сравнение с существующими методами" as T7
  rectangle "T8: Выводы и рекомендации\n• Для практики и науки" as T8
  rectangle "T9: Подготовка к защите\n• Слайды, отчет" as T9
