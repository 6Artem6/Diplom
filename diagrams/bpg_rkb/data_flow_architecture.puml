```cypher
MERGE (execution:ExecutionInstance {id: $execution_id})
SET execution.success_rate = $success_rate,
    execution.business_compliance = $compliance_score,
    execution.user_satisfaction = $satisfaction
MERGE (pattern:SuccessPattern {type: "add_to_cart"})
SET pattern.effectiveness += $effectiveness_delta
CREATE (execution)-[:VALIDATES]->(pattern)
