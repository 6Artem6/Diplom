    ```python
    def prepare_pattern_context(selected_patterns):
        pattern_context = []

        for pattern_info in selected_patterns:
            pattern = pattern_info["pattern"]

            # Сформировать краткое описание шагов
            formatted_steps = []
            for i, step in enumerate(pattern.steps):
                step_description = {
                    "step_number": i + 1,
                    "action": step.action,
                    "description": step.description,
                    "target": step.ui_element_selector,
                    "expected_result": step.expected_outcome
                }
                formatted_steps.append(step_description)

            # Подготовить бизнес-правила
            business_rules = []
            for rule in pattern.business_rules:
                business_rules.append({
                    "type": rule.type,
                    "description": rule.description,
                    "required": rule.is_required
                })

            pattern_context_info = {
                "name": pattern.name,
                "type": pattern.type,
                "description": pattern.description,
                "confidence": pattern.confidence,
                "success_rate": pattern.success_rate,
                "steps": formatted_steps,
                "preconditions": [pc.description for pc in pattern.preconditions],
                "postconditions": [pc.description for pc in pattern.postconditions],
                "business_rules": business_rules,
                "estimated_duration": pattern.estimated_duration
            }
            pattern_context.append(pattern_context_info)

        return pattern_context
    ```
