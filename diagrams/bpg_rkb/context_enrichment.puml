    def extract_entities_from_intent(user_intent):
        # Использовать NER (Named Entity Recognition)
        import spacy
        nlp = spacy.load("en_core_web_sm")
        doc = nlp(user_intent)

        extracted_entities = []
        for ent in doc.ents:
            entity_info = {
                "text": ent.text,
                "label": ent.label_,  # PERSON, ORG, etc.
                "start": ent.start_char,
                "end": ent.end_char
            }
            extracted_entities.append(entity_info)

        # Дополнительно искать domain-specific entities
        domain_entities = find_domain_entities(user_intent, bpg_entities)
        extracted_entities.extend(domain_entities)

        return extracted_entities
    ```

