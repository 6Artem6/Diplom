    **Top Pattern Selection:**

    ```python
    def select_top_patterns_for_context(available_patterns, max_patterns=3):
        # Сортировать по релевантности и уверенности
        sorted_patterns = sorted(available_patterns,
                               key=lambda x: (x["score"], x["pattern"].confidence),
                               reverse=True)

        selected_patterns = []
        total_tokens = 0
        max_tokens = 2500  # Бюджет токенов для контекста

        for pattern_info in sorted_patterns:
            pattern = pattern_info["pattern"]

            # Оценить количество токенов для этого паттерна
            pattern_tokens = estimate_pattern_tokens(pattern)

            if total_tokens + pattern_tokens <= max_tokens and len(selected_patterns) < max_patterns:
                selected_patterns.append(pattern_info)
                total_tokens += pattern_tokens
            else:
                break

        return selected_patterns, total_tokens
    ```
