    **Pattern Ranking and Combination:**

    ```python
    def rank_and_combine_patterns(semantic_patterns, entity_patterns, action_patterns):
        all_patterns = {}

        # Объединить все найденные паттерны
        for pattern in semantic_patterns + entity_patterns + action_patterns:
            pattern_id = pattern["pattern_id"]

            if pattern_id not in all_patterns:
                all_patterns[pattern_id] = {
                    "pattern_info": pattern,
                    "scores": [],
                    "sources": []
                }

            # Добавить оценку и источник
            if pattern in semantic_patterns:
                all_patterns[pattern_id]["scores"].append(("semantic", pattern["similarity_score"]))
            elif pattern in entity_patterns:
                all_patterns[pattern_id]["scores"].append(("entity", 0.8))
            elif pattern in action_patterns:
                all_patterns[pattern_id]["scores"].append(("action", pattern["action_confidence"]))

            all_patterns[pattern_id]["sources"].append(pattern["source"])

        # Вычислить комбинированный рейтинг
        ranked_patterns = []
        for pattern_id, info in all_patterns.items():
            # Взвешенная комбинация оценок
            combined_score = calculate_combined_score(info["scores"])

            # Бонус за множественные источники
            source_bonus = len(set(info["sources"])) * 0.1

            final_score = min(combined_score + source_bonus, 1.0)

            ranked_patterns.append({
                "pattern_id": pattern_id,
                "pattern_info": info["pattern_info"],
                "final_score": final_score,
                "sources": info["sources"]
            })

        # Сортировать по финальному рейтингу
        return sorted(ranked_patterns, key=lambda x: x["final_score"], reverse=True)
    ```
