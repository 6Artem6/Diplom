    def search_patterns_by_actions(detected_actions, pattern_database):
        action_patterns = []

        for action_info in detected_actions:
            action_type = action_info["action"]

            # Поиск паттернов с соответствующим типом действий
            if action_type == "enroll":
                # Поиск enrollment/registration паттернов
                matching_patterns = pattern_database.query("""
                    SELECT pattern_id, name, type, description, confidence
                    FROM patterns
                    WHERE LOWER(name) LIKE "%enroll%"
                       OR LOWER(name) LIKE "%register%"
                       OR LOWER(description) LIKE "%enrollment%"
                """)

            elif action_type == "create":
                matching_patterns = pattern_database.query("""
                    SELECT pattern_id, name, type, description, confidence
                    FROM patterns
                    WHERE type = "CRUD" AND name LIKE "%Create%"
                """)

            for pattern in matching_patterns:
                pattern_info = {
                    "pattern_id": pattern.pattern_id,
                    "name": pattern.name,
                    "type": pattern.type,
                    "confidence": pattern.confidence,
                    "matched_action": action_type,
                    "action_confidence": action_info["confidence"],
                    "source": "action_match"
                }
                action_patterns.append(pattern_info)

        return action_patterns
    ```
