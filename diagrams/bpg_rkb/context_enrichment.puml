  def build_enriched_llm_prompt(user_intent, entity_context, pattern_context, system_context):
      prompt_template = """
You are an expert business process automation agent with deep knowledge of the {domain} domain.
Use the provided business process knowledge to understand the user"s intent and plan appropriate actions.

## User Request
"{user_intent}"

## Current System Context
Current Page: {current_page}
User Role: {user_role}
User Permissions: {user_permissions}
Current Time: {current_time}

## Available Entities
{formatted_entities}

## Applicable Business Patterns
{formatted_patterns}

## Business Rules & Constraints
{formatted_business_rules}

## Instructions
1. Analyze the user request in the context of available business patterns
2. Select the most appropriate pattern to achieve the user"s goal
3. Verify all preconditions are met for the selected pattern
4. Plan specific UI actions using the pattern steps
5. Explain your reasoning and highlight any constraints or risks
6. If multiple patterns could work, recommend the most efficient path

## Response Format
Please respond in JSON format:
{
  "selected_pattern": "pattern_name",
  "confidence": 0.0-1.0,
  "reasoning": "explanation of pattern selection",
  "planned_steps": [
    {
      "step": 1,
      "action": "specific UI action",
      "target": "UI element selector",
      "parameters": {},
      "expected_result": "what should happen"
    }
  ],
  "preconditions_check": {
    "all_met": true/false,
    "missing": ["unmet preconditions"]
  },
  "risks_and_constraints": ["potential issues"],
  "alternative_patterns": ["other viable options"]
}
"""

      # Форматировать компоненты промпта
      formatted_prompt = prompt_template.format(
          domain=system_context["domain"],
          user_intent=user_intent,
          current_page=system_context["current_page"],
          user_role=system_context["user_info"]["role"],
          user_permissions=", ".join(system_context["user_info"]["permissions"]),
          current_time=system_context["session_info"]["current_timestamp"],
          formatted_entities=format_entities_for_prompt(entity_context),
          formatted_patterns=format_patterns_for_prompt(pattern_context),
          formatted_business_rules=format_business_rules_for_prompt(pattern_context)
      )

      return formatted_prompt
