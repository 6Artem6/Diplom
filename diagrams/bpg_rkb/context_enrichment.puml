    def semantic_pattern_search(user_intent, pattern_vector_db):
        # Создать эмбеддинг запроса пользователя
        query_embedding = sentence_transformer.encode(user_intent)

        # Поиск похожих паттернов в vector DB
        search_results = pattern_vector_db.query(
            query_embeddings=[query_embedding.tolist()],
            n_results=10,  # Топ-10 похожих паттернов
            include=["metadatas", "documents", "distances"]
        )

        relevant_patterns = []
        for i, distance in enumerate(search_results["distances"][0]):
            if distance < 0.4:  # Порог семантической близости
                pattern_info = {
                    "pattern_id": search_results["ids"][0][i],
                    "similarity_score": 1 - distance,  # Конвертировать в similarity
                    "metadata": search_results["metadatas"][0][i],
                    "description": search_results["documents"][0][i]
                }
                relevant_patterns.append(pattern_info)

        return sorted(relevant_patterns,
                     key=lambda x: x["similarity_score"], reverse=True)
    ```
  end note

