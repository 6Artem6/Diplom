    def prepare_entity_context(extracted_entities, bpg_graph):
        entity_context = []

        for entity_info in extracted_entities:
            # Найти соответствующие сущности в BPG
            bpg_entities = find_matching_bpg_entities(entity_info, bpg_graph)

            for bpg_entity in bpg_entities:
                # Загрузить атрибуты сущности
                attributes = load_entity_attributes(bpg_entity.id, bpg_graph)

                # Загрузить связанные сущности
                relationships = load_entity_relationships(bpg_entity.id, bpg_graph)

                entity_context_info = {
                    "name": bpg_entity.business_meaning,
                    "type": bpg_entity.entity_type,
                    "attributes": [{"name": attr.name, "type": attr.type}
                                  for attr in attributes],
                    "relationships": [{"type": rel.type, "target": rel.target_name}
                                    for rel in relationships],
                    "current_status": get_entity_current_status(bpg_entity, current_context)
                }
                entity_context.append(entity_context_info)

        return entity_context
    ```
