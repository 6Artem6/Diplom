    def extract_action_intents(user_intent):
        # Поиск глаголов действий
        action_patterns = {
            "enroll": ["enroll", "register", "sign up", "add to course"],
            "create": ["create", "add", "new", "make"],
            "update": ["update", "modify", "change", "edit"],
            "delete": ["delete", "remove", "cancel", "drop"],
            "view": ["show", "display", "view", "see", "find"]
        }

