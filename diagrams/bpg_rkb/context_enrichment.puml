    def search_patterns_by_entities(extracted_entities, bpg_graph):
        entity_patterns = []

        for entity_info in extracted_entities:
            # Найти соответствующие сущности в BPG
            matching_entities = find_matching_bpg_entities(entity_info, bpg_graph)

            for bpg_entity in matching_entities:
                # Найти паттерны, использующие эту сущность
                pattern_query = """
                MATCH (e:Entity {id: $entity_id})<-[:OPERATES_ON]-(p:Pattern)
                RETURN p.id, p.name, p.type, p.confidence, p.frequency
                """

                results = bpg_graph.run(pattern_query, entity_id=bpg_entity.id)

                for record in results:
                    pattern_info = {
                        "pattern_id": record["p.id"],
                        "name": record["p.name"],
                        "type": record["p.type"],
                        "confidence": record["p.confidence"],
                        "frequency": record["p.frequency"],
                        "matched_entity": bpg_entity,
                        "source": "entity_match"
                    }
                    entity_patterns.append(pattern_info)

        return entity_patterns
    ```
