    def check_pattern_availability(ranked_patterns, current_context):
        available_patterns = []

        for pattern_info in ranked_patterns:
            pattern_id = pattern_info["pattern_id"]

            # Загрузить полную информацию о паттерне
            full_pattern = load_pattern_details(pattern_id)

            # Проверить предусловия
            preconditions_met = True
            unmet_preconditions = []

            for precondition in full_pattern.preconditions:
                if not evaluate_precondition(precondition, current_context):
                    preconditions_met = False
                    unmet_preconditions.append(precondition)

            # Проверить доступность UI элементов
            ui_elements_available = True
            unavailable_ui = []

            for step in full_pattern.steps:
                if step.ui_element_selector:
                    if not is_ui_element_available(step.ui_element_selector, current_context):
                        ui_elements_available = False
                        unavailable_ui.append(step.ui_element_selector)

            # Проверить права пользователя
            user_permissions_ok = check_user_permissions(full_pattern, current_context.user)

            # Добавить в доступные если все проверки пройдены
            if preconditions_met and ui_elements_available and user_permissions_ok:
                available_patterns.append({
                    "pattern": full_pattern,
                    "score": pattern_info["final_score"],
                    "sources": pattern_info["sources"]
                })
            else:
                # Логировать причины недоступности
                log_pattern_unavailability(pattern_id, {
                    "preconditions_met": preconditions_met,
                    "unmet_preconditions": unmet_preconditions,
                    "ui_elements_available": ui_elements_available,
                    "unavailable_ui": unavailable_ui,
                    "permissions_ok": user_permissions_ok
                })

        return available_patterns
    ```
