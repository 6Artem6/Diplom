    def detect_domain_context(entities, actions, current_system_state):
        domain_indicators = {
            "academic": ["student", "course", "enroll", "grade", "semester"],
            "ecommerce": ["product", "order", "purchase", "cart", "payment"],
            "crm": ["customer", "lead", "contact", "deal", "opportunity"],
            "hr": ["employee", "department", "salary", "position", "hire"]
        }

        domain_scores = {}

        # Анализ сущностей и действий
        text_to_analyze = " ".join([e["text"] for e in entities] +
                                  [a["action"] for a in actions])

        for domain, keywords in domain_indicators.items():
            score = sum(1 for keyword in keywords
                       if keyword.lower() in text_to_analyze.lower())
            domain_scores[domain] = score / len(keywords)

        # Учесть контекст текущей страницы
        if current_system_state.current_page:
            page_domain = infer_domain_from_page(current_system_state.current_page)
            if page_domain in domain_scores:
                domain_scores[page_domain] += 0.3

        # Выбрать домен с наивысшим скором
        detected_domain = max(domain_scores, key=domain_scores.get)

        return {
            "domain": detected_domain,
            "confidence": domain_scores[detected_domain],
            "all_scores": domain_scores
        }
    ```

    **Результат:** {"domain": "academic", "confidence": 0.8}
