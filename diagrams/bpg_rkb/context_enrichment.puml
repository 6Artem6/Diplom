  ```python
  def process_llm_response(llm_response, user_intent):
      try:
          response_data = json.loads(llm_response)

          # Валидация структуры ответа
          required_fields = ["selected_pattern", "confidence", "reasoning", "planned_steps"]
          for field in required_fields:
              if field not in response_data:
                  raise ValueError(f"Missing required field: {field}")

          # Валидация уверенности
          if not (0.0 <= response_data["confidence"] <= 1.0):
              response_data["confidence"] = 0.5  # Значение по умолчанию

          # Валидация запланированных шагов
          if not response_data["planned_steps"]:
              raise ValueError("No planned steps provided")

          processed_response = LLMActionPlan(
              selected_pattern=response_data["selected_pattern"],
              confidence=response_data["confidence"],
              reasoning=response_data["reasoning"],
              planned_steps=response_data["planned_steps"],
              preconditions_check=response_data.get("preconditions_check", {}),
              risks=response_data.get("risks_and_constraints", []),
              alternatives=response_data.get("alternative_patterns", [])
          )

          return processed_response

      except (json.JSONDecodeError, ValueError, KeyError) as e:
          # Обработка ошибок парсинга
          error_response = create_error_response(str(e), user_intent)
          return error_response
  ```
