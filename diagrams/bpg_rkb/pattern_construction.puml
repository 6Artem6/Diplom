  **Pattern Storage in BPG:**

  ```python
  def store_patterns_in_bpg(patterns, graph_db):
      for pattern in patterns:
          # Создать узел паттерна
          pattern_query = """
          CREATE (p:Pattern {
              id: $pattern_id,
              name: $name,
              type: $type,
              confidence: $confidence,
              frequency: $frequency,
              llm_validated: $llm_validated,
              created_at: datetime()
          })
          """

          graph_db.run(pattern_query,
              pattern_id=pattern.id,
              name=pattern.name,
              type=pattern.type,
              confidence=pattern.overall_confidence,
              frequency=pattern.frequency,
              llm_validated=pattern.llm_validated
          )

          # Связать с сущностями
          for entity in pattern.involved_entities:
              entity_link_query = """
              MATCH (p:Pattern {id: $pattern_id})
              MATCH (e:Entity {id: $entity_id})
              CREATE (p)-[:OPERATES_ON]->(e)
              """
              graph_db.run(entity_link_query,
                  pattern_id=pattern.id,
                  entity_id=entity.entity_id
              )

          # Сохранить шаги паттерна
          for step_index, step in enumerate(pattern.steps):
              step_query = """
              MATCH (p:Pattern {id: $pattern_id})
              CREATE (s:PatternStep {
                  order: $step_order,
                  action: $action,
                  description: $description,
                  ui_element: $ui_element
              })
              CREATE (p)-[:HAS_STEP]->(s)
              """
              graph_db.run(step_query,
                  pattern_id=pattern.id,
                  step_order=step_index,
                  action=step.action,
                  description=step.description,
                  ui_element=step.ui_element_selector
              )
  ```
