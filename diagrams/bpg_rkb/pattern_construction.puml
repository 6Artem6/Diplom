    def detect_crud_patterns(entities, ui_interactions):
        crud_patterns = []

        for entity in entities:
            if entity.entity_type != "DataEntity":
                continue

            crud_operations = {
                "create": [],
                "read": [],
                "update": [],
                "delete": []
            }

            # Анализ UI взаимодействий для каждой операции
            for interaction in ui_interactions:
                if involves_entity(interaction, entity):
                    operation_type = classify_crud_operation(interaction, entity)
                    if operation_type:
                        crud_operations[operation_type].append(interaction)

            # Создать CRUD паттерн если есть операции
            if any(len(ops) > 0 for ops in crud_operations.values()):
                crud_pattern = CRUDPattern(
                    entity=entity,
                    create_steps=extract_steps(crud_operations["create"]),
                    read_steps=extract_steps(crud_operations["read"]),
                    update_steps=extract_steps(crud_operations["update"]),
                    delete_steps=extract_steps(crud_operations["delete"])
                )
                crud_patterns.append(crud_pattern)

        return crud_patterns
    ```
