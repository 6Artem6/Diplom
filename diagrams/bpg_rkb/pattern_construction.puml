    def extract_business_rules(patterns, entities, relationships):
        business_rules = []

        for pattern in patterns:
            # Анализ предусловий
            preconditions = []

            # Правила на основе отношений сущностей
            for entity in pattern.involved_entities:
                entity_relations = get_entity_relationships(entity, relationships)

                for relation in entity_relations:
                    if relation.type == "DEPENDS_ON":
                        precondition = BusinessRule(
                            type="precondition",
                            description=f"{entity.business_meaning} requires {relation.target.business_meaning}",
                            entities=[entity, relation.target],
                            confidence=relation.confidence
                        )
                        preconditions.append(precondition)

            # Правила на основе атрибутов
            for entity in pattern.involved_entities:
                for attribute in entity.attributes:
                    if attribute.is_required:
                        rule = BusinessRule(
                            type="validation",
                            description=f"{attribute.name} is required for {entity.business_meaning}",
                            entities=[entity],
                            confidence=0.9
                        )
                        business_rules.append(rule)

            pattern.preconditions = preconditions

        return business_rules
    ```
