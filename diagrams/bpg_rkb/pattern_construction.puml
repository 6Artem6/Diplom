    **Entity-based Transition Grouping:**

    ```python
    def group_transitions_by_entity(transitions, entities):
        entity_transitions = {}

        for transition in transitions:
            # Найти сущности на исходном экране
            from_entities = find_entities_on_screen(
                transition.from_screen, entities)

            # Найти сущности на целевом экране
            to_entities = find_entities_on_screen(
                transition.to_screen, entities)

            # Найти общие сущности (та же сущность в разных видах)
            common_entities = find_common_entities(from_entities, to_entities)

            for entity in common_entities:
                if entity.entity_id not in entity_transitions:
                    entity_transitions[entity.entity_id] = []

                entity_transitions[entity.entity_id].append({
                    "transition": transition,
                    "from_view": get_entity_view_type(entity, transition.from_screen),
                    "to_view": get_entity_view_type(entity, transition.to_screen)
                })

        return entity_transitions
    ```
