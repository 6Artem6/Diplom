    def detect_navigation_patterns(entity_transitions):
        navigation_patterns = []

        for entity_id, transitions in entity_transitions.items():
            # Группировать по типам переходов
            transition_types = {}
            for trans in transitions:
                key = f"{trans.from_view} -> {trans.to_view}"
                if key not in transition_types:
                    transition_types[key] = []
                transition_types[key].append(trans)

            # Создать паттерны для частых переходов
            for transition_type, occurrences in transition_types.items():
                if len(occurrences) >= 3:  # Минимум 3 раза
                    pattern = NavigationPattern(
                        entity_id=entity_id,
                        from_view=occurrences[0].from_view,
                        to_view=occurrences[0].to_view,
                        trigger_elements=[occ.transition.trigger_element
                                        for occ in occurrences],
                        frequency=len(occurrences),
                        confidence=calculate_pattern_confidence(occurrences)
                    )
                    navigation_patterns.append(pattern)

        return navigation_patterns
    ```
