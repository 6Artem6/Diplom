    **Related Pattern Discovery:**

    ```python
    def find_related_patterns(patterns):
        pattern_relationships = []

        for pattern_a in patterns:
            for pattern_b in patterns:
                if pattern_a.id == pattern_b.id:
                    continue

                # Проверить пересечение сущностей
                shared_entities = set(pattern_a.entities) & set(pattern_b.entities)

                if shared_entities:
                    # Проверить временную последовательность
                    temporal_relation = analyze_temporal_relationship(
                        pattern_a, pattern_b)

                    if temporal_relation:
                        relationship = PatternRelationship(
                            source=pattern_a,
                            target=pattern_b,
                            type=temporal_relation.type,  # PRECEDES, FOLLOWS, PARALLEL
                            shared_entities=list(shared_entities),
                            confidence=temporal_relation.confidence
                        )
                        pattern_relationships.append(relationship)

        return pattern_relationships
    ```
  end note

