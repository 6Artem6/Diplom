    def create_composite_patterns(patterns, pattern_relationships):
        composite_patterns = []

        # Группировать связанные паттерны
        pattern_chains = find_pattern_chains(pattern_relationships)

        for chain in pattern_chains:
            if len(chain.patterns) >= 2:
                # Определить тип композиции
                composition_type = infer_composition_type(chain)

                composite = CompositePattern(
                    name=f"Composite_{chain.patterns[0].name}",
                    component_patterns=chain.patterns,
                    composition_type=composition_type,  # SEQUENTIAL, CONDITIONAL, PARALLEL
                    relationships=chain.relationships
                )

                # Вывести управляющие структуры
                if composition_type == "CONDITIONAL":
                    composite.conditions = extract_branching_conditions(chain)
                elif composition_type == "LOOP":
                    composite.loop_condition = extract_loop_condition(chain)

                composite_patterns.append(composite)

        return composite_patterns
    ```
