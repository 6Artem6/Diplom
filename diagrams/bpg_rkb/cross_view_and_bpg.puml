    def detect_spatial_relations(entity1, entity2):
        bbox1, bbox2 = entity1.bbox, entity2.bbox

        # Containment
        if is_contained(bbox1, bbox2):
            return "Contains"

        # Proximity
        distance = euclidean_distance(
            bbox1.center, bbox2.center)
        if distance < proximity_threshold:
            return "Adjacent"

        # Alignment
        if horizontal_aligned(bbox1, bbox2):
            return "HorizontalGroup"
    ```
