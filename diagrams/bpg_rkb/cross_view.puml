    layout_signatures = []
    for element in ui_elements:
        # Нормализованные координаты (0-1)
        norm_x = element.bbox.x / screenshot.width
        norm_y = element.bbox.y / screenshot.height
        norm_w = element.bbox.width / screenshot.width
        norm_h = element.bbox.height / screenshot.height

        # Layout признаки
        layout_sig = {
            "position": [norm_x, norm_y],
            "size": [norm_w, norm_h],
            "aspect_ratio": norm_w / norm_h,
            "area": norm_w * norm_h,
            "center": [norm_x + norm_w/2, norm_y + norm_h/2]
        }
        layout_signatures.append(layout_sig)
