```python
class ModernEmbeddingGenerator:
    def __init__(self):
    self.clip_model = CLIPModel.from_pretrained("openai/clip-vit-large-patch14")
    self.sentence\_model = SentenceTransformer('all-mpnet-base-v2')

      def generate_composite_embedding(self, ui_element):
          visual_emb = self.clip_model.encode_image(ui_element.cropped_image)
          text_emb = self.sentence_model.encode(ui_element.text_content) if ui_element.text_content else np.zeros(384)
          layout_emb = self.encode_layout_features(ui_element.spatial_context)
          return np.concatenate([visual_emb, text_emb, layout_emb])
```
