    **Foreign Key Inference:**

    ```python
    def infer_foreign_keys(entities):
        fk_relations = []

        for entity in entities:
            if entity.entity_type != "DataEntity":
                continue

            # Анализ атрибутов на предмет внешних ключей
            for attribute in entity.attributes:
                # Паттерн внешнего ключа: ends with "_id"
                if attribute.name.endswith("_id"):
                    referenced_entity_type = attribute.name.replace("_id", "")

                    # Поиск соответствующей сущности
                    for candidate in entities:
                        if (candidate.business_meaning.lower() ==
                            referenced_entity_type.lower() or
                            candidate.entity_type.lower().startswith(
                                referenced_entity_type.lower())):

                            # Проверка совпадения значений
                            value_match_confidence = check_value_matching(
                                attribute, candidate)

                            if value_match_confidence > 0.7:
                                fk_relation = ForeignKeyRelation(
                                    source_entity=entity,
                                    target_entity=candidate,
                                    source_attribute=attribute,
                                    confidence=value_match_confidence
                                )
                                fk_relations.append(fk_relation)

        return fk_relations
    ```
