    **Database Schema Generation:**

    ```python
    def generate_database_schema(entities, relations):
        schema = DatabaseSchema()

        # Создать таблицы из DataEntity сущностей
        data_entities = [e for e in entities
                        if e.entity_type == "DataEntity"]

        for entity in data_entities:
            table = Table(name=entity.business_meaning.lower().replace(" ", "_"))

            # Добавить колонки из атрибутов
            for attribute in entity.attributes:
                column_type = map_attribute_to_sql_type(attribute)
                column = Column(
                    name=attribute.name.lower(),
                    type=column_type,
                    nullable=not attribute.is_required,
                    primary_key=attribute.is_identifier
                )
                table.add_column(column)

            schema.add_table(table)

        # Создать внешние ключи из отношений
        fk_relations = [r for r in relations
                       if r.type == "FOREIGN_KEY_REFERENCE"]

        for fk_relation in fk_relations:
            source_table = find_table_by_entity(fk_relation.source_entity)
            target_table = find_table_by_entity(fk_relation.target_entity)

            foreign_key = ForeignKey(
                source_table=source_table.name,
                source_column=fk_relation.source_attribute.name,
                target_table=target_table.name,
                target_column="id"  # Предполагаем стандартный PK
            )
            schema.add_foreign_key(foreign_key)

        return schema
    ```
  end note
