    **Graph Node Creation:**

    ```python
    # Neo4j graph construction
    def create_entity_nodes(entities, graph_db):
        for entity in entities:
            node_query = """
            CREATE (e:Entity {
                id: $entity_id,
                type: $entity_type,
                business_meaning: $business_meaning,
                confidence: $confidence,
                created_at: datetime()
            })
            """

            graph_db.run(node_query,
                entity_id=entity.entity_id,
                entity_type=entity.entity_type,
                business_meaning=entity.business_meaning,
                confidence=entity.confidence_score
            )

            # Создать узлы атрибутов
            for attribute in entity.attributes:
                attr_query = """
                MATCH (e:Entity {id: $entity_id})
                CREATE (a:Attribute {
                    name: $attr_name,
                    value: $attr_value,
                    type: $attr_type,
                    confidence: $attr_confidence
                })
                CREATE (e)-[:HAS_ATTRIBUTE]->(a)
                """

                graph_db.run(attr_query,
                    entity_id=entity.entity_id,
                    attr_name=attribute.name,
                    attr_value=attribute.value,
                    attr_type=attribute.type,
                    attr_confidence=attribute.confidence
                )
    ```
  end note

