    def detect_spatial_relations(entities):
        spatial_relations = []

        for entity_a in entities:
            for entity_b in entities:
                if entity_a.entity_id == entity_b.entity_id:
                    continue

                # Ищем представления на одних и тех же скриншотах
                common_screenshots = find_common_screenshots(entity_a, entity_b)

                for screenshot_id in common_screenshots:
                    bbox_a = entity_a.get_bbox_on_screenshot(screenshot_id)
                    bbox_b = entity_b.get_bbox_on_screenshot(screenshot_id)

                    # Анализ пространственных отношений
                    if is_contained(bbox_a, bbox_b):
                        relation = SpatialRelation(
                            source=entity_b,
                            target=entity_a,
                            type="CONTAINS",
                            confidence=0.9
                        )
                        spatial_relations.append(relation)

                    elif are_adjacent(bbox_a, bbox_b):
                        relation = SpatialRelation(
                            source=entity_a,
                            target=entity_b,
                            type="ADJACENT",
                            confidence=0.7
                        )
                        spatial_relations.append(relation)

        return spatial_relations
    ```
  end note

