  **BPG Storage:**

  ```python
  def store_bpg(entities, relations, graph_db):
      # Создать узлы
      create_entity_nodes(entities, graph_db)

      # Создать связи
      create_relationship_edges(relations, graph_db)

      # Создать индексы для быстрого поиска
      index_queries = [
          "CREATE INDEX entity_id_index FOR (e:Entity) ON (e.id)",
          "CREATE INDEX entity_type_index FOR (e:Entity) ON (e.type)",
          "CREATE INDEX attribute_name_index FOR (a:Attribute) ON (a.name)"
      ]

      for query in index_queries:
          graph_db.run(query)

      # Сохранить метаданные BPG
      metadata = {
          "total_entities": len(entities),
          "total_relations": len(relations),
          "avg_confidence": calculate_avg_confidence(entities, relations),
          "created_at": datetime.now(),
          "version": "1.0"
      }

      store_bpg_metadata(metadata)
  ```
