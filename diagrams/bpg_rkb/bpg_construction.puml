    def validate_relationship_consistency(relations):
        validated_relations = []
        conflicts = []

        for relation in relations:
            # Проверка циклических зависимостей
            if creates_cycle(relation, validated_relations):
                conflicts.append({
                    "relation": relation,
                    "issue": "creates_cycle",
                    "severity": "high"
                })
                continue

            # Проверка бизнес-логики
            if violates_business_logic(relation):
                conflicts.append({
                    "relation": relation,
                    "issue": "business_logic_violation",
                    "severity": "medium"
                })
                continue

            validated_relations.append(relation)

        return validated_relations, conflicts
    ```
