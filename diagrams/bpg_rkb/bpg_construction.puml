    def detect_collection_relations(entities):
        collection_relations = []

        # Поиск сущностей-коллекций
        collection_entities = [e for e in entities
                             if e.entity_type == "CollectionEntity"]

        for collection in collection_entities:
            # Анализ содержимого коллекции
            for screenshot_id in collection.screenshot_ids:
                screenshot_entities = get_entities_on_screenshot(
                    entities, screenshot_id)

                # Поиск элементов, содержащихся в коллекции
                for entity in screenshot_entities:
                    if entity.entity_type == "DataEntity":
                        # Проверка пространственного включения
                        if is_spatially_contained(entity, collection, screenshot_id):
                            # Проверка семантического соответствия
                            if are_semantically_compatible(entity, collection):
                                relation = CollectionRelation(
                                    collection=collection,
                                    item=entity,
                                    type="CONTAINS_ITEM",
                                    confidence=0.85
                                )
                                collection_relations.append(relation)

        return collection_relations
    ```
