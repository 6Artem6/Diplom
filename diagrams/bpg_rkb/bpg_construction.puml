  # Создать семантические индексы для быстрого поиска
  def create_semantic_indexes(entities, vector_db):
      for entity in entities:
          # Создать текстовое описание сущности
          description = f"""
          Entity: {entity.business_meaning}
          Type: {entity.entity_type}
          Attributes: {", ".join([a.name for a in entity.attributes])}
          Context: Found on {len(entity.representations)} different screens
          """

          # Генерировать семантический эмбеддинг
          embedding = sentence_transformer.encode(description)

          # Сохранить в vector database
          vector_db.upsert(
              id=entity.entity_id,
              vector=embedding.tolist(),
              metadata={
                  "entity_type": entity.entity_type,
                  "business_meaning": entity.business_meaning,
                  "confidence": entity.confidence_score,
                  "attribute_count": len(entity.attributes)
              }
          )
  ```
