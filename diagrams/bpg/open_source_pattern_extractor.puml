partition "📚 Phase 6: Template Library Construction" #PaleGreen {
  :💾 Template Database Population;
  note right
def build_template_library(validated_patterns):
    template_library = TemplateLibrary()

    # High-quality patterns (score > 0.8)
    for pattern in filter_high_quality(validated_patterns):
        if pattern.category == "entity":
            template_library.add_entity_template(
                template=pattern.to_entity_template(),
                domains=pattern.applicable_domains,
                confidence=pattern.overall_quality
            )

        elif pattern.category == "relationship":
            template_library.add_relationship_template(
                template=pattern.to_relationship_template(),
                frequency=pattern.frequency_score,
                domains=pattern.applicable_domains
            )

        elif pattern.category == "process":
            template_library.add_process_template(
                template=pattern.to_process_template(),
                complexity=pattern.complexity_score,
                domains=pattern.applicable_domains
            )

        elif pattern.category == "atomic_action":
            template_library.add_atomic_action_template(
                template=pattern.to_atomic_action_template(),
                reliability=pattern.reliability_score,
                ui_compatibility=pattern.ui_compatibility_score
            )

    # Create cross-references and indices
    template_library.build_similarity_indices()
    template_library.create_domain_mappings()
    template_library.generate_pattern_hierarchies()

    return template_library
  end note

