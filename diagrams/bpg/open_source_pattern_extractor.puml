  :📊 Entity Pattern Discovery;
  note right
    class EntityPatternExtractor:
        def extract_from_multiple_sources(self, system_analysis):
            entities = {}

            # From database models
            db_entities = self.extract_from_db_models(
                system_analysis.data_model
            )

            # From API endpoints
            api_entities = self.extract_from_api_patterns(
                system_analysis.api_patterns
            )

            # From UI forms and views
            ui_entities = self.extract_from_ui_patterns(
                system_analysis.ui_patterns
            )

            # Consolidate and categorize
            for entity in merge_entity_sources(
                db_entities, api_entities, ui_entities
            ):
                entities[entity.name] = EntityTemplate(
                    name = entity.name,
                    category = self.classify_entity_category(entity),
                    attributes = entity.attributes,
                    relationships = entity.relationships,
                    ui_manifestations = entity.ui_patterns,
                    source_evidence = entity.evidence
                )

            return entities

        def classify_entity_category(self, entity):
            # Rule-based classification
            if self.has_user_attributes(entity):
                return EntityCategory.ACTOR
            elif self.has_transaction_patterns(entity):
                return EntityCategory.TRANSACTION_OBJECT
            elif self.has_hierarchical_structure(entity):
                return EntityCategory.CONTAINER
            elif self.has_state_machine(entity):
                return EntityCategory.PROCESS
            else:
                return EntityCategory.BUSINESS_OBJECT
  end note

  :🔗 Relationship Pattern Mining;
  note right
    def extract_relationship_patterns(systems_data):
        relationship_patterns = []

        for system in systems_data:
            # Database foreign keys
            db_relationships = extract_db_relationships(
                system.schema,
                include_cardinality = True,
                include_constraints = True
            )

            # Code-level associations
            code_relationships = extract_code_associations(
                system.models,
                frameworks = system.framework
            )

            # UI interaction patterns
            ui_relationships = extract_ui_interactions(
                system.pages,
                identify_workflows = True
            )

            # Business logic relationships
            business_relationships = extract_business_rules(
                system.controllers,
                system.services
            )

            # Consolidate into templates
            for rel in consolidate_relationships(
                db_relationships,
                code_relationships,
                ui_relationships,
                business_relationships
            ):
                relationship_patterns.append(
                    RelationshipTemplate(
                        source_category = rel.source.category,
                        target_category = rel.target.category,
                        relationship_type = rel.semantic_type,
                        cardinality = rel.cardinality,
                        business_rules = rel.constraints,
                        evidence_strength = rel.frequency_across_systems,
                        source_systems = rel.found_in_systems
                    )
                )

        return relationship_patterns
  end note
}

partition "⚙️ Phase 4: Process Pattern Extraction" #LightCoral {

  :🔄 Workflow Pattern Discovery;
  note right
    class ProcessPatternExtractor:
        def extract_process_patterns(self, systems_analysis):
            process_patterns = []

            # Extract from user documentation
            doc_processes = self.extract_from_documentation(
                systems_analysis.user_guides,
                workflow_indicators = [
                    "step 1", "first", "then", "next", "finally",
                    "to [action]", "how to", "process for"
                ]
            )

            # Extract from controller actions
            code_processes = self.extract_from_controllers(
                systems_analysis.controllers,
                identify_action_sequences = True,
                track_state_changes = True
            )

            # Extract from UI flows
            ui_processes = self.extract_from_ui_flows(
                systems_analysis.navigation_patterns,
                identify_form_sequences = True,
                track_page_transitions = True
            )

            # Cross-validate and consolidate
            for pattern in self.consolidate_patterns(
                doc_processes, code_processes, ui_processes
            ):
                process_patterns.append(
                    ProcessPatternTemplate(
                        name = pattern.name,
                        category = self.classify_process_category(pattern),
                        required_entities = pattern.entities,
                        typical_workflow = pattern.steps,
                        business_rules = pattern.rules,
                        ui_requirements = pattern.ui_elements,
                        evidence_sources = pattern.sources
                    )
                )

            return process_patterns

        def classify_process_category(self, pattern):
            if self.is_crud_pattern(pattern):
                return ProcessCategory.CRUD
            elif self.is_search_pattern(pattern):
                return ProcessCategory.SEARCH_FILTER
            elif self.is_transaction_pattern(pattern):
                return ProcessCategory.TRANSACTION
            elif self.is_approval_pattern(pattern):
                return ProcessCategory.WORKFLOW
            else:
                return ProcessCategory.DOMAIN_SPECIFIC
  end note

  :🤖 Atomic Action Extraction;
