    def extract_atomic_actions(systems_ui_analysis):
        atomic_actions = []

        # Analyze common UI interactions
        ui_interactions = aggregate_ui_interactions(
            systems_ui_analysis,
            group_by_element_type = True
        )

        for interaction_group in ui_interactions:
            action_template = AtomicActionTemplate(
                action_type = interaction_group.action_type,
                target_element_type = interaction_group.element_type,
                parameters = extract_common_parameters(
                    interaction_group.instances
                ),
                success_indicators = identify_success_patterns(
                    interaction_group.outcomes
                ),
                failure_modes = identify_failure_patterns(
                    interaction_group.errors
                ),
                ui_selectors = extract_common_selectors(
                    interaction_group.elements
                ),
                verification_methods = determine_verification(
                    interaction_group.expected_outcomes
                )
            )
            atomic_actions.append(action_template)

        return atomic_actions
  end note
