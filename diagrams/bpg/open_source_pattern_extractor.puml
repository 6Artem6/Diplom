def validate_extracted_patterns(patterns, source_systems):
    validation_results = []

    for pattern in patterns:
        # Check pattern frequency across systems
        frequency = calculate_pattern_frequency(
            pattern, source_systems
        )

        # Validate pattern completeness
        completeness = validate_pattern_completeness(
            pattern,
            required_elements=["entities", "relationships", "workflow"]
        )

        # Check business logic consistency
        consistency = validate_business_consistency(
            pattern,
            against_domain_standards=True
        )

        # Assess generalizability
        generalizability = assess_pattern_generalizability(
            pattern,
            across_domains=True
        )

        validation_results.append(ValidationResult(
            pattern=pattern,
            frequency_score=frequency,
            completeness_score=completeness,
            consistency_score=consistency,
            generalizability_score=generalizability,
            overall_quality=weighted_average([
                frequency * 0.3,
                completeness * 0.3,
                consistency * 0.25,
                generalizability * 0.15
            ])
        ))

    return validation_results
  end note

